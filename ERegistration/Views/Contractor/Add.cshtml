@using ERegistration.ViewModels
@model ContractorAddViewModel

<h2>Add a new contractor</h2>
<hr />

@if (ViewData["ErrorMessage"] != null)
{
<p class="text-danger">@ViewData["ErrorMessage"]</p>
}

<form method="post" asp-controller="Contractor" asp-action="Add">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row">
        <div class="col-md-4 form-floating">
            <input asp-for="Contractor.FirstName" class="form-control" />
            <label asp-for="Contractor.FirstName" class="control-label fw-bold"></label>
            <span asp-validation-for="Contractor.FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-floating">
            <input asp-for="Contractor.MiddleName" class="form-control" />
            <label asp-for="Contractor.MiddleName" class="control-label"></label>
            <span asp-validation-for="Contractor.MiddleName" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-floating">
            <input asp-for="Contractor.LastName" class="form-control" />
            <label asp-for="Contractor.LastName" class="control-label fw-bold"></label>
            <span asp-validation-for="Contractor.LastName" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 form-floating">
            <input asp-for="Contractor.BusinessName" class="form-control" />
            <label asp-for="Contractor.BusinessName" class="control-label"></label>
            <span asp-validation-for="Contractor.BusinessName" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-floating">
            @Html.DropDownListFor(model => model.SelectedBusinessTypeId, Model.BusinessTypes, " ", new { @class = "form-select" })
            @Html.LabelFor(model => model.SelectedBusinessTypeId, "BusinessType")
            @Html.ValidationMessageFor(model => model.SelectedBusinessTypeId, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4 form-floating">
            <input asp-for="Contractor.BusinessTrade" class="form-control" />
            <label asp-for="Contractor.BusinessTrade" class="control-label"></label>
            <span asp-validation-for="Contractor.BusinessTrade" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 form-floating">
            <input asp-for="Contractor.ContactName" class="form-control" />
            <label asp-for="Contractor.ContactName" class="control-label"></label>
            <span asp-validation-for="Contractor.ContactName" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-floating">
            <input asp-for="Contractor.LicenseNumber" class="form-control" />
            <label asp-for="Contractor.LicenseNumber" class="control-label"></label>
            <span asp-validation-for="Contractor.LicenseNumber" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-floating">
            <input asp-for="Contractor.BusinessId" class="form-control" />
            <label asp-for="Contractor.BusinessId" class="control-label"></label>
            <span asp-validation-for="Contractor.BusinessId" class="text-danger"></span>
        </div>
    </div>

    @*    <div class="row">
            <fieldset class="p-3 fw-bold">
                <legend>Address</legend>
                @Html.EditorFor(model => model.Contractor.Address)
            </fieldset>
        </div>
        <div class="row">
            <fieldset class="p-3">
                <legend>Mailing Address</legend>
                @Html.EditorFor(model => model.Contractor.MailingAddress)
            </fieldset>
        </div> *@

    <div class="row">
        <fieldset class="p-3">
            <legend>Address</legend>
            <div class="row">
                <div class="col-md-6 form-floating">
                    <input asp-for="Contractor.Address_Line1" class="form-control" />
                    <label asp-for="Contractor.Address_Line1" class="control-label fw-bold"></label>
                    <span asp-validation-for="Contractor.Address_Line1" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-floating">
                    <input asp-for="Contractor.Address_Line2" class="form-control" />
                    <label asp-for="Contractor.Address_Line2" class="control-label"></label>
                    <span asp-validation-for="Contractor.Address_Line2" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 form-floating">
                    <input asp-for="Contractor.Address_City" class="form-control" />
                    <label asp-for="Contractor.Address_City" class="control-label fw-bold"></label>
                    <span asp-validation-for="Contractor.Address_City" class="text-danger"></span>
                </div>
                <div class="col-md-3 form-floating">
                    <select asp-for="Contractor.Address_StateId" class="form-select" asp-items="Model.States">
                        <option value="" selected></option>
                    </select>
                    <label asp-for="States" class="fw-bold">State</label>
                    <span asp-validation-for="Contractor.Address_StateId" class="text-danger"></span>
                </div>
                <div class="col-md-3 form-floating">
                    <input asp-for="Contractor.Address_ZipCode" class="form-control" />
                    <label asp-for="Contractor.Address_ZipCode" class="control-label fw-bold"></label>
                    <span asp-validation-for="Contractor.Address_ZipCode" class="text-danger"></span>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="row">
        <fieldset class="p-3">
            <legend>Mailing Address</legend>
            <div class="row">
                <div class="col-md-6 form-floating">
                    <input asp-for="Contractor.MailingAddress_Line1" class="form-control" />
                    <label asp-for="Contractor.MailingAddress_Line1" class="control-label"></label>
                    <span asp-validation-for="Contractor.MailingAddress_Line1" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-floating">
                    <input asp-for="Contractor.MailingAddress_Line2" class="form-control" />
                    <label asp-for="Contractor.MailingAddress_Line2" class="control-label"></label>
                    <span asp-validation-for="Contractor.MailingAddress_Line2" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 form-floating">
                    <input asp-for="Contractor.MailingAddress_City" class="form-control" />
                    <label asp-for="Contractor.MailingAddress_City" class="control-label"></label>
                    <span asp-validation-for="Contractor.MailingAddress_City" class="text-danger"></span>
                </div>
                <div class="col-md-3 form-floating">
                    <select asp-for="Contractor.MailingAddress_StateId" class="form-select" asp-items="Model.States">
                        <option value="" selected></option>
                    </select>
                    <label asp-for="States">State</label>
                    <span asp-validation-for="States" class="text-danger"></span>
                </div>
                <div class="col-md-3 form-floating">
                    <input asp-for="Contractor.MailingAddress_ZipCode" class="form-control" />
                    <label asp-for="Contractor.MailingAddress_ZipCode" class="control-label"></label>
                    <span asp-validation-for="Contractor.MailingAddress_ZipCode" class="text-danger"></span>
                </div>
            </div>
        </fieldset>
    </div>

    <div class="row">
        <div class="col-md-4 form-floating">
            <input asp-for="Contractor.OfficePhone" class="form-control" />
            <label asp-for="Contractor.OfficePhone" class="control-label">Office#</label>
            <span asp-validation-for="Contractor.OfficePhone" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-floating">
            <input asp-for="Contractor.CellPhone" class="form-control" />
            <label asp-for="Contractor.CellPhone" class="control-label">Cell#</label>
            <span asp-validation-for="Contractor.CellPhone" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-floating">
            <input asp-for="Contractor.Email" class="form-control" />
            <label asp-for="Contractor.Email" class="control-label fw-bold">Email</label>
            <span asp-validation-for="Contractor.Email" class="text-danger"></span>
        </div>
    </div>

    <button type="button" asp-action="Index" asp-controller="NoticeOfCommencement" class="btn btn-secondary">Cancel</button>
    <button type="submit" asp-controller="Contractor" asp-action="Add" class="btn btn-primary">Save</button>

</form>
<div>
    <a asp-controller="NoticeOfCommencement" asp-action="Index">Back to Notice Of Commencement Creation</a>
</div>