    </div>
    <div class="row">
        <div class="col-md-4 form-floating">
            <input asp-for="@Model.Lender.Address_City" class="form-control" />
            <label asp-for="@Model.Lender.Address_City" class="control-label"></label>
            <span asp-validation-for="@Model.Lender.Address_City" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-floating">
            <select asp-for="@Model.Lender.Address_StateId" class="form-select" asp-items="@Model.Lender.Address_State"></select>
            <label asp-for="@Model.Lender.Address_StateId"></label>
            <span asp-validation-for="@Model.Lender.Address_StateId" class="text-danger"></span>
