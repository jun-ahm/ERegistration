@using ERegistration.ViewModels
@model NoticeOfCommencementEditViewModel

<h2>Update for @($"{Model.Project.Address_Line1}, {Model.Project.Address_Line2}, {Model.Project.Address_City}")</h2>
<hr />
<form method="post" asp-controller="NoticeOfCommencement" asp-action="Edit">
