            <input asp-for="@Model.Lender.OfficePhone" class="form-control" />
            <label asp-for="@Model.Lender.OfficePhone" class="control-label"></label>
            <span asp-validation-for="@Model.Lender.OfficePhone" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-floating">
