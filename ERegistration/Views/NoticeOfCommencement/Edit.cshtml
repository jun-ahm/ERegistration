    </div>
    <div class="row">
        <div class="col-md-6 form-floating">
            <input asp-for="@Model.Lender.Address_Line1" class="form-control" />
            <label asp-for="@Model.Lender.Address_Line1" class="control-label"></label>
            <span asp-validation-for="@Model.Lender.Address_Line1" class="text-danger"></span>
        </div>
        <div class="col-md-6 form-floating">
            <input asp-for="@Model.Lender.Address_Line2" class="form-control" />
            <label asp-for="@Model.Lender.Address_Line2" class="control-label"></label>
            <span asp-validation-for="@Model.Lender.Address_Line2" class="text-danger"></span>
