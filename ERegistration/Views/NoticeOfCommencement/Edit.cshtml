        <div class="col-md-4 form-floating">
            <input asp-for="@Model.PropertyOwners[i].FirstName" class="form-control" />
            <label asp-for="@Model.PropertyOwners[i].FirstName" class="form-label fw-bold"></label>
            <span asp-validation-for="@Model.PropertyOwners[i].FirstName" class="text-danger"></span>
        </div>
