        <div class="col-md-3 form-floating">
            <select asp-for="@Model.Project.Address_StateId" class="form-select" asp-items="@Model.Project.Address_State"></select>
            <label asp-for="@Model.Project.Address_StateId"></label>
            <span asp-validation-for="@Model.Project.Address_StateId" class="text-danger"></span>
        </div>
        <div class="col-md-3 form-floating">
            <input asp-for="@Model.Project.Address_ZipCode" class="form-control" />
            <label asp-for="@Model.Project.Address_ZipCode" class="control-label"></label>
            <span asp-validation-for="@Model.Project.Address_ZipCode" class="text-danger"></span>
        </div>
        <div class="col-md-3 form-floating">
            <input asp-for="@Model.Project.County" class="form-control" />
            <label asp-for="@Model.Project.County" class="control-label"></label>
            <span asp-validation-for="@Model.Project.County" class="text-danger"></span>
