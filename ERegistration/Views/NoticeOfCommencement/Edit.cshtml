            <label asp-for="@Model.PropertyOwners[i].Address_Line2" class="control-label"></label>
            <span asp-validation-for="@Model.PropertyOwners[i].Address_Line2" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 form-floating">
            <input asp-for="@Model.PropertyOwners[i].Address_City" class="form-control" />
            <label asp-for="@Model.PropertyOwners[i].Address_City" class="control-label"></label>
            <span asp-validation-for="@Model.PropertyOwners[i].Address_City" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-floating">
            <select asp-for="@Model.PropertyOwners[i].Address_StateId" class="form-select" asp-items="@Model.PropertyOwners[i].Address_State"></select>
            <label asp-for="@Model.PropertyOwners[i].Address_StateId"></label>
            <span asp-validation-for="@Model.PropertyOwners[i].Address_StateId" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-floating">
            <input asp-for="@Model.PropertyOwners[i].Address_ZipCode" class="form-control" />
            <label asp-for="@Model.PropertyOwners[i].Address_ZipCode" class="control-label"></label>
            <span asp-validation-for="@Model.PropertyOwners[i].Address_ZipCode" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 form-floating">
            <input asp-for="@Model.PropertyOwners[i].Email" class="form-control" />
            <label asp-for="@Model.PropertyOwners[i].Email" class="control-label"></label>
            <span asp-validation-for="@Model.PropertyOwners[i].Email" class="text-danger"></span>
